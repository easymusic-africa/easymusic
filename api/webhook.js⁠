import { createClient } from '@supabase/supabase-js';

const supabase = createClient(
  process.env.SUPABASE_URL,
  process.env.SUPABASE_SERVICE_ROLE_KEY
);

export default async function handler(req, res) {
  if (req.method !== 'POST') {
    return res.status(405).json({ error: 'Method not allowed' });
  }

  try {
    const payload = req.body || {};
    const data = payload.data || payload;
    const reference = data.reference;
    const status = (data.status || '').toLowerCase();

    if (!reference) {
      return res.status(400).json({ error: 'Missing reference' });
    }

    const verifyRes = await fetch(
      `https://api.notchpay.co/payments/${encodeURIComponent(reference)}`,
      {
        headers: {
          Authorization: process.env.NOTCHPAY_PUBLIC_KEY,
        },
      }
    );

    const verifyJson = await verifyRes.json();
    const verifiedStatus = (
      verifyJson?.transaction?.status ||
      verifyJson?.data?.status ||
      status
    ).toLowerCase();

    const { data: txData, error: txError } = await supabase
      .from('transactions')
      .select('*')
      .eq('transaction_id', reference)
      .single();

    if (txError || !txData) {
      return res.status(404).json({ error: 'Transaction not found' });
    }

    if (verifiedStatus === 'complete' || verifiedStatus === 'completed') {
      if (txData.status !== 'COMPLETED') {
        await supabase
          .from('transactions')
          .update({ status: 'COMPLETED' })
          .eq('transaction_id', reference);

        const { data: profileData } = await supabase
          .from('profiles')
          .select('credits')
          .eq('id', txData.user_id)
          .single();

        const currentCredits = profileData?.credits || 0;
        const addedCredits = txData.credits || 1;

        await supabase
          .from('profiles')
          .update({ credits: currentCredits + addedCredits })
          .eq('id', txData.user_id);
      }

      return res.status(200).json({ success: true });
    }

    if (verifiedStatus === 'failed' || verifiedStatus === 'canceled' || verifiedStatus === 'cancelled') {
      await supabase
        .from('transactions')
        .update({ status: 'FAILED' })
        .eq('transaction_id', reference);
    }

    return res.status(200).json({ received: true });
  } catch (error) {
    console.error('Erreur webhook Notch Pay:', error);
    return res.status(500).json({ error: 'Internal server error' });
  }
}
