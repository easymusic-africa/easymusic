import { createClient } from '@supabase/supabase-js';
import axios from 'axios';

const supabase = createClient(
  process.env.SUPABASE_URL,
  process.env.SUPABASE_SERVICE_ROLE_KEY
);

export default async function handler(req, res) {
  if (req.method !== "POST") {
    return res.status(405).json({ error: "Méthode non autorisée" });
  }

  try {
    const transactionId = req.body.cpm_trans_id || req.body.transaction_id;

    if (!transactionId) {
      return res.status(400).json({ error: "Identifiant de transaction manquant." });
    }

    // Vérification officielle auprès de CinetPay (Anti-fraude)
    const verificationResponse = await axios.post('https://api-checkout.cinetpay.com/v2/payment/check', {
      apikey: process.env.CINETPAY_API_KEY,
      site_id: process.env.CINETPAY_SITE_ID,
      transaction_id: transactionId
    });

    const paymentResult = verificationResponse.data;

    if (paymentResult && paymentResult.code === '00') {
      // Récupération de la transaction dans Supabase
      const { data: txData, error: txError } = await supabase
        .from('transactions')
        .select('*')
        .eq('transaction_id', transactionId)
        .single();

      if (txError || !txData) {
        return res.status(404).json({ error: "Transaction introuvable en base de données." });
      }

      if (txData.status === 'SUCCESS') {
        return res.status(200).json({ message: "Transaction déjà traitée." });
      }

      // Mise à jour du statut en SUCCESS
      await supabase
        .from('transactions')
        .update({ status: 'SUCCESS' })
        .eq('transaction_id', transactionId);

      // Récupération des crédits actuels de l'utilisateur
      const { data: profileData } = await supabase
        .from('profiles')
        .select('credits')
        .eq('id', txData.user_id)
        .single();

      const currentCredits = profileData ? profileData.credits : 0;
      const newCredits = currentCredits + txData.credits_added;

      // Ajout des crédits
      await supabase
        .from('profiles')
        .update({ credits: newCredits })
        .eq('id', txData.user_id);

      return res.status(200).json({ success: true, message: "Paiement validé et crédits ajoutés." });
    } else {
      await supabase
        .from('transactions')
        .update({ status: 'FAILED' })
        .eq('transaction_id', transactionId);

      return res.status(400).json({ error: "Paiement non validé par l'opérateur." });
    }

  } catch (error) {
    console.error("Erreur Webhook:", error.message);
    return res.status(500).json({ error: "Erreur interne du serveur", details: error.message });
  }
}
